# Wa3d.ma environment variables (docs/devops-wa3d-ma.md §2).
# All values are public build-time settings; the project has no secrets.
# Copy to .env.local for local development. Never commit .env or .env.local.

# Absolute base URL for canonical links, hreflang and the sitemap (https only).
# Placeholder until an own domain is bought (runbook R3).
NEXT_PUBLIC_SITE_URL=https://wa3d-ma.vercel.app

# Shows the 2021-2026 archive when "true". Read at build time.
# Stays false until the embargo lifts (on or after 2026-09-24, runbook R1).
NEXT_PUBLIC_ARCHIVE_ENABLED=false

# Public repository, used for "Signaler une erreur" issue links.
NEXT_PUBLIC_REPO_URL=https://github.com/rhorba/wa3d-ma

# CI/test only: catalogue folder to build from. Unset means "data".
# CI E2E uses tests/fixtures/catalogue/valid.
# WA3D_DATA_DIR=
