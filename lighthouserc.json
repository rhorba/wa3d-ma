{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3000/fr/2021-2026",
        "http://localhost:3000/ar/2021-2026",
        "http://localhost:3000/fr/2021-2026/fictif-emploi",
        "http://localhost:3000/ar/2021-2026/fictif-emploi"
      ],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": ["performance", "accessibility"],
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }]
          }
        },
        {
          "matchingUrlPattern": "/(fr|ar)/2021-2026$",
          "aggregationMethod": "median-run",
          "assertions": {
            "resource-summary:script:size": ["error", { "maxNumericValue": 133120 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
